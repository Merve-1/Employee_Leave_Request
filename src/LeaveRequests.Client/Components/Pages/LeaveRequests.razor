@page "/leave-requests"
@rendermode InteractiveServer

@using global::LeaveRequests.Client.Auth
@using global::LeaveRequests.Client.Models
@using global::LeaveRequests.Client.Auth

@inject IHttpClientFactory HttpClientFactory
@inject Microsoft.Extensions.Options.IOptions<AuthOptions> AuthOptionsAccessor

<PageTitle>Leave Requests</PageTitle>

<h3>Leave Requests</h3>

<div class="mb-3">
    <label for="statusFilter" class="form-label">Status</label>

    <select id="statusFilter"
            class="form-select"
            @bind="selectedStatus">
        <option value="">All</option>
        <option value="Pending">Pending</option>
        <option value="Approved">Approved</option>
        <option value="Rejected">Rejected</option>
    </select>
</div>
<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">New Leave Request</h5>

        @if (isLoadingEmployee)
        {
            <p>Loading employees...</p>
        }
        else if (!string.IsNullOrWhiteSpace(employeesErrorMessage))
        {
            <div class="alert alert-danger">
                @employeesErrorMessage
                <button class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadEmployeesAsync">
                    Retry
                </button>
            </div>
        }
        else
        {
            <EditForm Model="newRequest" FormName="NewLeaveRequestForm" OnValidSubmit="SubmitNewRequestAsync">
                <AntiforgeryToken/>
                <DataAnnotationsValidator/>
                <ValidationSummary class="text-danger"/>

                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Employee</label>
                        <InputSelect class="form-select" @bind-Value="newRequest.EmployeeId">
                            <option value="">-- Select employee --</option>
                            @foreach (var emp in employees)
                            {
                                <option value="@emp.Id">@emp.Name</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Start Date</label>
                        <InputDate class="form-control" @bind-Value="newRequest.StartDate"/>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">End Date</label>
                        <InputDate class="form-control" @bind-Value="newRequest.EndDate"/>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="newRequest.LeaveType">
                            <option value="">-- Select type --</option>
                            <option value="Vacation">Vacation</option>
                            <option value="Sick">Sick</option>
                            <option value="Unpaid">Unpaid</option>
                        </InputSelect>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
                            @(isSubmitting ? "Submitting..." : "Submit")
                        </button>
                    </div>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(submitErrorMessage))
            {
                <div class="alert alert-danger mt-3">@submitErrorMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(submitSuccessMessage))
            {
                <div class="alert alert-success mt-3">@submitSuccessMessage</div>
            }
        }
    </div>
</div>
@if (isLoading)
{
    <p>Loading leave requests...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (FilteredLeaveRequests.Count == 0)
{
    <p>No leave requests found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Employee</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Type</th>
                <th>Status</th>
                <th>Actions</th>

                
            </tr>
        </thead>

        <tbody>
            @foreach (var request in FilteredLeaveRequests)
            {
                var isBusy = processingIds.Contains(request.Id);
                var isPending = request.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase);

                <tr>
                    <td>@request.EmployeeName</td>
                    <td>@request.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>@request.LeaveType</td>
                    <td>@request.Status</td>
                    <td>
                        @if (isPending && isHrUser)
                        {
                            <button class="btn btn-sm btn-success me-1"
                                    disabled="@isBusy"
                                    @onclick="() => ApproveAsync(request.Id)">
                                Approve
                            </button>
                            <button class="btn btn-sm btn-warning me-1"
                                    disabled="@isBusy"
                                    @onclick="() => RejectAsync(request.Id)">
                                Reject
                            </button>
                            <button class="btn btn-sm btn-danger"
                                    disabled="@isBusy"
                                    @onclick="() => DeleteAsync(request.Id)">
                                Delete
                            </button>
                        }
                        else
                        {
                            <span class="text-muted">&mdash;</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private string DebugClaimsJson => JwtService.GetClaims(Jwt) is { } claims
            ? string.Join(", ", claims.Select(kv => $"{kv.Key} = {kv.Value}"))
            : "NO CLAIMS FOUND";
    private List<EmployeeDto> employees = new();
    private bool isLoadingEmployee = true;
    private bool isSubmitting = false;

    private string? employeesErrorMessage;
    private string? submitErrorMessage;
    private string? submitSuccessMessage;

    private CreateLeaveRequestDto newRequest = new();
    
    private List<LeaveRequestDto> leaveRequests = new();

    private bool isLoading = true;

    private string? errorMessage;

    private string selectedStatus = "";
    
    private bool isHrUser;
    private HashSet<int> processingIds = new();
    private string? actionErrorMessage;

    private string Jwt => AuthOptionsAccessor.Value.HardcodedJwt;


    private List<LeaveRequestDto> FilteredLeaveRequests =>
        string.IsNullOrWhiteSpace(selectedStatus)
            ? leaveRequests
            : leaveRequests
                .Where(x => x.Status.Equals(
                    selectedStatus,
                    StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        isHrUser = string.Equals(
            JwtService.GetRole(Jwt),
            "HR",
            StringComparison.OrdinalIgnoreCase);
       

            await LoadLeaveRequestsAsync();
            await LoadEmployeesAsync();
         
    }

    private async Task LoadLeaveRequestsAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var http = HttpClientFactory.CreateClient("LeaveApi");
            var response = await http.GetAsync("api/leave-requests?pageSize=100");
            
            if (!response.IsSuccessStatusCode)
            {
                employeesErrorMessage = $"Failed to load leave requests. " + $"Server returned {(int)response.StatusCode}" +
                                        $"({response.ReasonPhrase})";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<List<LeaveRequestDto>>();
            leaveRequests = result ?? new List<LeaveRequestDto>();
        }
        catch (Exception e)
        {
            employeesErrorMessage = $"Failed to load leave request: {e.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            isLoadingEmployee = true;
            employeesErrorMessage = null;

            var http = HttpClientFactory.CreateClient("LeaveApi");
            var response = await http.GetAsync("api/employees");
            if (!response.IsSuccessStatusCode)
            {
                employeesErrorMessage = $"Failed to load employees. " + $"Server returned {(int)response.StatusCode}" +
                                        $"({response.ReasonPhrase})";
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<List<EmployeeDto>>();
            employees = result ?? new List<EmployeeDto>();
        }
        catch (Exception e)
        {
            employeesErrorMessage = $"Failed to load employee: {e.Message}";
        }
        finally
        {
            isLoadingEmployee = false;
        }
    }

    public async Task SubmitNewRequestAsync()
    {
        try
        {
            isSubmitting = true;
            submitErrorMessage = null;
            submitSuccessMessage = null;
            
            var http = HttpClientFactory.CreateClient("LeaveApi");
            var response = await http.PostAsJsonAsync("api/leave-requests", newRequest);
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                submitErrorMessage = $"Failed to submit leave request. " + $"Server returned {(int)response.StatusCode}" +
                                     $"({response.ReasonPhrase}).{body}";
                return;
            }

            submitSuccessMessage = "Leave request submitted.";
            newRequest = new CreateLeaveRequestDto();
            await LoadLeaveRequestsAsync();
        }
        catch (Exception e)
        {
            submitErrorMessage = $"Failed to submit leave request: {e.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
      private Task ApproveAsync(int id) => UpdateStatusAsync(id, "Approved");
    private Task RejectAsync(int id) => UpdateStatusAsync(id, "Rejected");

    private async Task UpdateStatusAsync(int id, string newStatus)
    {
        try
        {
            processingIds.Add(id);
            actionErrorMessage = null;

            var http = HttpClientFactory.CreateClient("LeaveApi");
            http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);

            var response = await http.PutAsJsonAsync(
                $"api/leave-requests/{id}/status",
                new { status = newStatus });

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                actionErrorMessage =
                    $"Failed to update request #{id}. " +
                    $"Server returned {(int)response.StatusCode} " +
                    $"({response.ReasonPhrase}). {body}";
                return;
            }

            await LoadLeaveRequestsAsync();
        }
        catch (Exception ex)
        {
            actionErrorMessage = $"Failed to update request #{id}: {ex.Message}";
        }
        finally
        {
            processingIds.Remove(id);
        }
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            processingIds.Add(id);
            actionErrorMessage = null;

            var http = HttpClientFactory.CreateClient("LeaveApi");
            http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Jwt);

            var response = await http.DeleteAsync($"api/leave-requests/{id}");

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                actionErrorMessage =
                    $"Failed to delete request #{id}. " +
                    $"Server returned {(int)response.StatusCode} " +
                    $"({response.ReasonPhrase}). {body}";
                return;
            }

            await LoadLeaveRequestsAsync();
        }
        catch (Exception ex)
        {
            actionErrorMessage = $"Failed to delete request #{id}: {ex.Message}";
        }
        finally
        {
            processingIds.Remove(id);
        }
    }
}